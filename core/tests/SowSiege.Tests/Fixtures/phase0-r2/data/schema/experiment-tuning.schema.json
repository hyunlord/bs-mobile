{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tuning": {
      "$ref": "tuning"
    },
    "enemyOverrides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          },
          "speed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "damage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "health": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "attackCooldownTicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "id",
          "speed",
          "damage",
          "health",
          "attackCooldownTicks"
        ],
        "additionalProperties": false
      }
    },
    "experiment": {
      "type": "object",
      "properties": {
        "movement": {
          "type": "object",
          "properties": {
            "circuitOffsets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "decisionPeriodTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "evadeRange": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "evadeStep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "circuitOffsets",
            "decisionPeriodTicks",
            "evadeRange",
            "evadeStep"
          ],
          "additionalProperties": false
        },
        "experience": {
          "type": "object",
          "properties": {
            "base": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "linear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "quadratic": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "base",
            "linear",
            "quadratic"
          ],
          "additionalProperties": false
        },
        "mixedCategoryOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "weapon",
              "land",
              "building",
              "people"
            ]
          }
        }
      },
      "required": [
        "movement",
        "experience",
        "mixedCategoryOrder"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tuning",
    "enemyOverrides",
    "experiment"
  ],
  "additionalProperties": false
}
