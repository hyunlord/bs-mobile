{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["id", "startingTool", "damageMultiplier"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"},
    "startingTool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"},
    "damageMultiplier": {"type": "integer", "minimum": 1, "maximum": 1000}
  }
}
