    "experiment": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "tuningFile": {
          "type": "string",
          "pattern": "^(experiments/)?tuning-s4b-[a-zA-Z0-9_-]+\\.json$"
        }
      },
      "required": [
        "contractVersion",
        "tuningFile"
      ],
      "additionalProperties": false
    },
    "weaponCombat": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "enum": [
            1,
            2
          ]
        },
        "definitionsFile": {
          "type": "string",
          "pattern": "^(experiments/)?weapon-growth-[a-zA-Z0-9_-]+\\.json$"
        }
      },
      "required": [
        "contractVersion"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "contractVersion": {
                "const": 1
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "definitionsFile"
            ],
            "properties": {
              "definitionsFile": {}
            },
            "type": "object"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "contractVersion": {
                "const": 2
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "definitionsFile": {
                "type": "string",
                "pattern": "^experiments/weapon-growth-[a-zA-Z0-9_-]+\\.json$"
              }
            }
          }
        }
