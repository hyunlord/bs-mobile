{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weapon",
          "melee",
          "ranged",
          "orbit",
          "land",
          "harvest",
          "building",
          "repair",
          "people",
          "muster",
          "control",
          "food",
          "fertility",
          "defense",
          "economy",
          "growth"
        ]
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "designStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "s2-runtime"
      ]
    },
    "implementationNote": {
      "type": "string",
      "minLength": 1
    },
    "loopLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "estateId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "estateId",
          "stage",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "kind": {
      "type": "string",
      "enum": [
        "weapon-tool",
        "tool-tool",
        "tool-growth"
      ]
    },
    "inputIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "growthCondition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "land",
                "building",
                "people"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "seeded",
                "growing",
                "ripe",
                "built",
                "ruined",
                "rebuilt",
                "staffed",
                "mobilized",
                "returned"
              ]
            },
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "target",
            "state",
            "minimum"
          ],
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "baseId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "baseId",
        "name",
        "effect",
        "cost"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "concept",
    "tags",
    "designStatus",
    "implementationNote",
    "loopLinks",
    "kind",
    "inputIds",
    "growthCondition",
    "result"
  ],
  "additionalProperties": false
}
