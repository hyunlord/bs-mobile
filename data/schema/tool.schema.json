{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tags",
    "activation",
    "growth",
    "floorRationale",
    "antiSynergy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damage",
        "range",
        "cooldownTicks",
        "shape",
        "knockback"
      ],
      "properties": {
        "damage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "range": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "shape": {
          "type": "string",
          "enum": [
            "melee",
            "projectile",
            "orbit",
            "wave"
          ]
        },
        "knockback": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "yield"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "land",
            "building",
            "people"
          ]
        },
        "yield": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "floorRationale": {
      "type": "string",
      "minLength": 1
    },
    "antiSynergy": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    }
  }
}
