{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S0 synthetic tool",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tags", "activation", "growth", "floorRationale", "antiSynergy"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "activation": {"type": "object", "additionalProperties": false, "required": ["damage"], "properties": {"damage": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
    "growth": {"type": "object", "additionalProperties": false, "required": ["target", "yield"], "properties": {"target": {"type": "string", "minLength": 1}, "yield": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
    "floorRationale": {"type": "string", "minLength": 1},
    "antiSynergy": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"}}
  }
}
