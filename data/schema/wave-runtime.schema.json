          "kind": {
            "enum": [
              "weapon",
              "tool",
              "item",
              "evolution",
              "enemy",
              "chapter"
            ]
          },
          "designRef": {
            "type": "object",
            "properties": {
              "catalog": {
                "const": "data/system-design-v1.json"
