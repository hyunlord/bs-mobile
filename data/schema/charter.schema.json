{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weapon",
          "melee",
          "ranged",
          "orbit",
          "land",
          "harvest",
          "building",
          "repair",
          "people",
          "muster",
          "control",
          "food",
          "fertility",
          "defense",
          "economy",
          "growth"
        ]
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "designStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "s2-runtime",
        "s4-runtime"
      ]
    },
    "implementationNote": {
      "type": "string",
      "minLength": 1
    },
    "loopLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "estateId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "estateId",
          "stage",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "effect": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "weapon",
            "land",
            "building",
            "people"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "benefit": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "trigger",
        "benefit",
        "cost"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "runtimeProjection": {
      "type": "object",
      "properties": {
        "policyCategory": {
          "enum": [
            "weapon",
            "land",
            "building",
            "people"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
              },
              "trigger": {
                "enum": [
                  "attack",
                  "harvest",
                  "repair",
                  "plant",
                  "farm-hit",
                  "draft",
                  "return-start",
                  "return-arrival",
                  "estate-cross",
                  "kill",
                  "modifier"
                ]
              },
              "operation": {
                "enum": [
                  "damage-pulse",
                  "repair-nearest",
                  "worker-buff",
                  "rally-returners",
                  "plant-path",
                  "shield-farms",
                  "harvest-near",
                  "damage-young-plots",
                  "extend-duty",
                  "guard-return",
                  "pause-neighbor-growth",
                  "return-via-building",
                  "planting-bias",
                  "stat-add"
                ]
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "radius": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "durationTicks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "foodCost": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "equipment-owned",
                        "owned-tag",
                        "equipment-tag",
                        "equipment-id",
                        "equipment-kind",
                        "growth-target",
                        "near-seed",
                        "near-ripe",
                        "near-building",
                        "estate-inside",
                        "estate-outside",
                        "building-ruined",
                        "building-new",
                        "person-role",
                        "enemy-target",
                        "season",
                        "count",
                        "shield-consumed"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "minimum": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "kind",
                    "value",
                    "minimum"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 1000
              }
            },
            "required": [
              "id",
              "trigger",
              "operation",
              "subject",
              "amount",
              "radius",
              "durationTicks",
              "foodCost",
              "conditions"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "policyCategory",
        "effects"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "concept",
    "tags",
    "designStatus",
    "implementationNote",
    "loopLinks",
    "effect",
    "requirements"
  ],
  "additionalProperties": false
}
