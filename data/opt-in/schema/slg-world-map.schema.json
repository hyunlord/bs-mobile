{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in server world map, GDD18 hypothesis layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "schemaVersion", "status", "numericStatus", "sources", "worldId", "width", "height", "chunkSize", "registeredAccountTarget", "defaultTerrain", "terrainPatches", "startRegion", "startAnchor", "initialTargets", "notes"],
  "properties": {
    "id": { "const": "slg:world_map_v1" },
    "kind": { "const": "slg-world-map" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "hypothesis" },
    "numericStatus": { "const": "[가설]" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "worldId": { "$ref": "#/$defs/id" },
    "width": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "height": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "chunkSize": { "type": "integer", "minimum": 1 },
    "registeredAccountTarget": { "type": "integer", "minimum": 1 },
    "defaultTerrain": { "$ref": "#/$defs/terrain" },
    "terrainPatches": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["terrain", "x", "y", "width", "height"],
        "properties": {
          "terrain": { "$ref": "#/$defs/terrain" },
          "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "startRegion": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      }
    },
    "startAnchor": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    },
    "initialTargets": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["targetId", "kind", "contentId", "x", "y", "generation"],
        "properties": {
          "targetId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["resource", "monster", "stronghold"] },
          "contentId": { "$ref": "#/$defs/id" },
          "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
          "generation": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$" },
    "terrain": { "enum": ["plain", "forest", "mountain", "water", "bridge"] }
  }
}
