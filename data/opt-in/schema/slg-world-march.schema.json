{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in world march timing and slot policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "schemaVersion", "status", "numericStatus", "sources", "slots", "edgeMilliseconds"],
  "properties": {
    "id": {"const": "slg:world_march_v1"},
    "kind": {"const": "slg-world-march"},
    "schemaVersion": {"const": 1},
    "status": {"const": "hypothesis"},
    "numericStatus": {"const": "[가설]"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "slots": {"type": "integer", "minimum": 1},
    "edgeMilliseconds": {"type": "integer", "minimum": 1000, "multipleOf": 1000}
  }
}
