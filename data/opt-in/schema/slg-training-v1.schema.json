{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sowsiege:slg-training-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "barracksKind",
    "maximumBonusPermille",
    "levels",
    "units"
  ],
  "properties": {
    "version": {
      "const": "slg-training-v1"
    },
    "status": {
      "const": "prototype-hypothesis"
    },
    "barracksKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "maximumBonusPermille": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "capacity",
          "batchLimit"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "batchLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitId",
          "name",
          "requiredBarracksLevel",
          "secondsPerUnit",
          "costPerUnit"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requiredBarracksLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "secondsPerUnit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "costPerUnit": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      }
    }
  }
}
