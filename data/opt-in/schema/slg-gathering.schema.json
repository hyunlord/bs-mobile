{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server finite resource gathering hypotheses",
  "type": "object", "additionalProperties": false,
  "required": ["id", "kind", "schemaVersion", "status", "numericStatus", "sources", "policy", "resources"],
  "properties": {
    "id": { "const": "slg:gathering_v1" }, "kind": { "const": "slg-gathering" }, "schemaVersion": { "const": 1 },
    "status": { "const": "hypothesis" }, "numericStatus": { "const": "[가설]" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["stock", "unitsPerSoldierMinute", "capacityPerSoldier", "respawnMilliseconds"],
      "properties": {
        "stock": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "unitsPerSoldierMinute": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "capacityPerSoldier": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "respawnMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["contentId", "materialId"],
      "properties": {
        "contentId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$" },
        "materialId": { "type": "string", "pattern": "^meta:[a-z][a-z0-9_]*$" }
      }
    } }
  }
}
