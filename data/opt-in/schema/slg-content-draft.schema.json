{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opt-in SLG content authoring draft (not runtime data)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "schemaVersion",
    "status",
    "numericStatus",
    "runtimeEnabled",
    "sources",
    "units",
    "sharedCaps",
    "contracts",
    "troops",
    "heroes",
    "researchNodes",
    "worldEncounters"
  ],
  "properties": {
    "id": {
      "const": "slg:content_draft_v1"
    },
    "kind": {
      "const": "slg-content-draft"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "hypothesis"
    },
    "numericStatus": {
      "const": "[가설]"
    },
    "runtimeEnabled": {
      "const": false
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "seconds",
        "meters",
        "resources",
        "counts",
        "combat"
      ],
      "properties": {
        "percent": {
          "type": "string",
          "minLength": 1
        },
        "seconds": {
          "type": "string",
          "minLength": 1
        },
        "meters": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "string",
          "minLength": 1
        },
        "counts": {
          "type": "string",
          "minLength": 1
        },
        "combat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sharedCaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run.heroDamagePercent",
        "run.heroMaxHealthPercent",
        "run.heroMovementPercent",
        "run.growthPercent",
        "run.allyDamagePercent",
        "run.allyMaxHealthPercent",
        "run.experiencePercent",
        "training.speedPercent",
        "construction.speedPercent",
        "march.speedPercent",
        "estate.grainProductionPercent",
        "estate.timberProductionPercent",
        "estate.ironProductionPercent",
        "estate.storageSeconds"
      ],
      "properties": {
        "run.heroDamagePercent": {
          "const": 10
        },
        "run.heroMaxHealthPercent": {
          "const": 15
        },
        "run.heroMovementPercent": {
          "const": 5
        },
        "run.growthPercent": {
          "const": 10
        },
        "run.allyDamagePercent": {
          "const": 15
        },
        "run.allyMaxHealthPercent": {
          "const": 15
        },
        "run.experiencePercent": {
          "const": 8
        },
        "training.speedPercent": {
          "const": 30
        },
        "construction.speedPercent": {
          "const": 30
        },
        "march.speedPercent": {
          "const": 10
        },
        "estate.grainProductionPercent": {
          "const": 20
        },
        "estate.timberProductionPercent": {
          "const": 20
        },
        "estate.ironProductionPercent": {
          "const": 20
        },
        "estate.storageSeconds": {
          "const": 18000
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numericScope",
        "aggregation",
        "effectTiming",
        "skillActivation",
        "heroParity",
        "researchScope",
        "troopConservation",
        "implementationStatus",
        "barracksLevels",
        "injuryPercent",
        "queues",
        "materialReward",
        "settlement",
        "personalFallback",
        "validationStatus"
      ],
      "properties": {
        "numericScope": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "type": "string",
          "minLength": 1
        },
        "effectTiming": {
          "type": "string",
          "minLength": 1
        },
        "skillActivation": {
          "type": "string",
          "minLength": 1
        },
        "heroParity": {
          "type": "string",
          "minLength": 1
        },
        "researchScope": {
          "type": "string",
          "minLength": 1
        },
        "troopConservation": {
          "type": "string",
          "minLength": 1
        },
        "implementationStatus": {
          "const": "draft-only-not-loaded-by-runtime"
        },
        "barracksLevels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "totalCapacity",
              "marchCapacity",
              "beds",
              "batchCapacity"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "totalCapacity": {
                "type": "integer",
                "minimum": 0
              },
              "marchCapacity": {
                "type": "integer",
                "minimum": 0
              },
              "beds": {
                "type": "integer",
                "minimum": 0
              },
              "batchCapacity": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "injuryPercent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pve",
            "pvp"
          ],
          "properties": {
            "pve": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pvp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "queues": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activeTraining",
            "waitingTraining",
            "activeHealing",
            "activeResearch",
            "waitingResearch"
          ],
          "properties": {
            "activeTraining": {
              "const": 1
            },
            "waitingTraining": {
              "const": 1
            },
            "activeHealing": {
              "const": 1
            },
            "activeResearch": {
              "const": 1
            },
            "waitingResearch": {
              "const": 1
            }
          }
        },
        "materialReward": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "carryPerDepartingSoldier",
            "carryPerSurvivingSoldier",
            "resourceOrder",
            "preDispatchRule",
            "victoryRule",
            "returnRule"
          ],
          "properties": {
            "carryPerDepartingSoldier": {
              "const": 10
            },
            "carryPerSurvivingSoldier": {
              "const": 10
            },
            "resourceOrder": {
              "const": [
                "grain",
                "timber",
                "iron"
              ]
            },
            "preDispatchRule": {
              "type": "string",
              "minLength": 1
            },
            "victoryRule": {
              "type": "string",
              "minLength": 1
            },
            "returnRule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "settlement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "battleCommit",
            "returnCommit",
            "eligibility",
            "worldState"
          ],
          "properties": {
            "authority": {
              "const": "server-validated-result-only"
            },
            "battleCommit": {
              "type": "string",
              "minLength": 1
            },
            "returnCommit": {
              "type": "string",
              "minLength": 1
            },
            "eligibility": {
              "type": "string",
              "minLength": 1
            },
            "worldState": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "personalFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heroId",
            "minimumTroops",
            "requiresResearch",
            "requiresCollectedHero",
            "entryCost",
            "materialRewardCap",
            "pendingMaterialCap",
            "proofIds",
            "rule"
          ],
          "properties": {
            "heroId": {
              "const": "core:frontier_knight"
            },
            "minimumTroops": {
              "const": 0
            },
            "requiresResearch": {
              "const": false
            },
            "requiresCollectedHero": {
              "const": false
            },
            "entryCost": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "grain",
                "timber",
                "iron"
              ],
              "properties": {
                "grain": {
                  "const": 0
                },
                "timber": {
                  "const": 0
                },
                "iron": {
                  "const": 0
                }
              }
            },
            "materialRewardCap": {
              "const": 60
            },
            "pendingMaterialCap": {
              "const": 60
            },
            "proofIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validationStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "balance",
            "server",
            "unity",
            "device"
          ],
          "properties": {
            "schema": {
              "enum": [
                "PENDING",
                "PASS"
              ]
            },
            "balance": {
              "const": "NOT_RUN"
            },
            "server": {
              "const": "NOT_RUN"
            },
            "unity": {
              "const": "NOT_RUN"
            },
            "device": {
              "const": "NOT_RUN"
            }
          }
        }
      }
    },
    "troops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/troop"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "heroes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hero"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "researchNodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/research"
      },
      "minItems": 10,
      "maxItems": 10
    },
    "worldEncounters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/encounter"
      },
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "troop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "numericStatus",
        "proposalOrigin",
        "sources",
        "role",
        "artReference",
        "training",
        "healing",
        "combat",
        "carryUnitsPerSoldier"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "hypothesis"
        },
        "numericStatus": {
          "const": "[가설]"
        },
        "proposalOrigin": {
          "enum": [
            "gdd-baseline",
            "new-draft"
          ]
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "artReference": {
          "type": "string",
          "minLength": 1
        },
        "training": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buildingId",
            "cost",
            "secondsPerUnit",
            "minimumLevel"
          ],
          "properties": {
            "buildingId": {
              "const": "meta:barracks"
            },
            "cost": {
              "$ref": "#/$defs/cost"
            },
            "secondsPerUnit": {
              "type": "integer",
              "minimum": 1
            },
            "minimumLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "healing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buildingId",
            "cost",
            "secondsPerUnit"
          ],
          "properties": {
            "buildingId": {
              "const": "meta:barracks"
            },
            "cost": {
              "$ref": "#/$defs/cost"
            },
            "secondsPerUnit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "combat": {
          "$ref": "#/$defs/combat"
        },
        "carryUnitsPerSoldier": {
          "const": 10
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "numericStatus",
        "proposalOrigin",
        "sources",
        "rarity",
        "level",
        "promotion",
        "baseCombat",
        "passive",
        "skill",
        "relatedEncounterIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "hypothesis"
        },
        "numericStatus": {
          "const": "[가설]"
        },
        "proposalOrigin": {
          "enum": [
            "gdd-baseline",
            "new-draft"
          ]
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "rarity": {
          "enum": [
            "common",
            "rare",
            "epic"
          ]
        },
        "level": {
          "const": 1
        },
        "promotion": {
          "const": 0
        },
        "baseCombat": {
          "$ref": "#/$defs/combat"
        },
        "passive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "effect"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "effect": {
              "$ref": "#/$defs/effect"
            }
          }
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "trigger",
            "cooldownSeconds",
            "durationSeconds",
            "radiusMeters",
            "maxTargets",
            "effect",
            "budgetNote"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "trigger": {
              "enum": [
                "auto-when-objective-within-radius-and-cooldown-ready",
                "auto-when-enemy-within-radius-and-cooldown-ready"
              ]
            },
            "cooldownSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "durationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radiusMeters": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxTargets": {
              "type": "integer",
              "minimum": 1
            },
            "effect": {
              "$ref": "#/$defs/effect"
            },
            "budgetNote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "relatedEncounterIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "numericStatus",
        "proposalOrigin",
        "sources",
        "category",
        "level",
        "prerequisites",
        "cost",
        "seconds",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "hypothesis"
        },
        "numericStatus": {
          "const": "[가설]"
        },
        "proposalOrigin": {
          "enum": [
            "gdd-baseline",
            "new-draft"
          ]
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "category": {
          "enum": [
            "economy",
            "military",
            "estate"
          ]
        },
        "level": {
          "const": 1
        },
        "prerequisites": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buildings",
            "nodes",
            "proofId"
          ],
          "properties": {
            "buildings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "level"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "meta:scriptorium",
                      "meta:barracks",
                      "meta:forge",
                      "meta:granary",
                      "m3a:field",
                      "m3a:lumber_camp",
                      "m3a:ironworks",
                      "m3a:home",
                      "m3a:watchtower"
                    ]
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "level"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "level": {
                    "const": 1
                  }
                }
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "proofId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "numericStatus",
        "proposalOrigin",
        "sources",
        "category",
        "enemyReferences",
        "enemyReferenceUse",
        "minimumTroops",
        "recommendedTroops",
        "timeLimitSeconds",
        "objective",
        "materialReward",
        "outcomes",
        "requiredHeroId",
        "entryCost",
        "respawnSeconds",
        "repeatPolicy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "hypothesis"
        },
        "numericStatus": {
          "const": "[가설]"
        },
        "proposalOrigin": {
          "enum": [
            "gdd-baseline",
            "new-draft"
          ]
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "category": {
          "enum": [
            "monster",
            "stronghold"
          ]
        },
        "enemyReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "enemyReferenceUse": {
          "type": "string",
          "minLength": 1
        },
        "minimumTroops": {
          "type": "integer",
          "minimum": 1
        },
        "recommendedTroops": {
          "type": "integer",
          "minimum": 1
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "holdSeconds",
            "description"
          ],
          "properties": {
            "type": {
              "const": "defeat-and-hold"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "holdSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "materialReward": {
          "$ref": "#/$defs/cost"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zoneEligibilityId",
            "researchProofIds",
            "worldState"
          ],
          "properties": {
            "zoneEligibilityId": {
              "enum": [
                "zone:inner-fields",
                "zone:inner-northeast-wood",
                "zone:inner-west-hill",
                "zone:inner-ruins",
                "zone:inner-riverside"
              ]
            },
            "researchProofIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "worldState": {
              "enum": [
                "defeated-resource-threat-removed",
                "recovered"
              ]
            }
          }
        },
        "requiredHeroId": {
          "const": null
        },
        "entryCost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grain",
            "timber",
            "iron"
          ],
          "properties": {
            "grain": {
              "const": 0
            },
            "timber": {
              "const": 0
            },
            "iron": {
              "const": 0
            }
          }
        },
        "respawnSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "repeatPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grain",
        "timber",
        "iron"
      ],
      "properties": {
        "grain": {
          "type": "integer",
          "minimum": 0
        },
        "timber": {
          "type": "integer",
          "minimum": 0
        },
        "iron": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxHealth",
        "attackDamage",
        "attackIntervalSeconds",
        "rangeMeters",
        "moveMetersPerSecond"
      ],
      "properties": {
        "maxHealth": {
          "type": "integer",
          "minimum": 1
        },
        "attackDamage": {
          "type": "integer",
          "minimum": 1
        },
        "attackIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rangeMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "moveMetersPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "value",
        "unit",
        "scope"
      ],
      "properties": {
        "domain": {
          "enum": [
            "run.heroDamagePercent",
            "run.heroMaxHealthPercent",
            "run.heroMovementPercent",
            "run.growthPercent",
            "run.allyDamagePercent",
            "run.allyMaxHealthPercent",
            "run.experiencePercent",
            "training.speedPercent",
            "construction.speedPercent",
            "march.speedPercent",
            "estate.grainProductionPercent",
