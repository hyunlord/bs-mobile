# Preserve supplied design bytes and machine-produced evidence verbatim.
docs/design/*.md -text
docs/evidence/** -text -whitespace

# Unity editable scene/asset metadata; large media stays in LFS.
unity/**/*.unity text eol=lf -whitespace
unity/**/*.prefab text eol=lf -whitespace
unity/**/*.asset text eol=lf -whitespace
unity/**/*.meta text eol=lf -whitespace
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
