# Local-only credential. Copy to .env and generate a unique value; never commit .env.
POSTGRES_PASSWORD=
# Local-only recruit HMAC key, 64+ hex chars (e.g. openssl rand -hex 32). Never commit .env.
RECRUIT_SEED_KEY=
# Local-only account pseudonym HMAC key (ADR0080 §5.1), 64+ hex chars, distinct from the seed key. Never commit .env.
AUTH_PSEUDONYM_KEY=
# Social login secrets: inject these into the Host environment, not into a client or a PR.
# Compose does not automatically forward these optional Host settings.
Auth__Social__CredentialKey=
Auth__Social__Apple__TeamId=
Auth__Social__Apple__KeyId=
Auth__Social__Apple__PrivateKeyPem=
# Register the actual Apple/Google client IDs before enabling their challenge paths.
Auth__Social__Providers__0__Provider=
Auth__Social__Providers__0__ClientId=
Auth__Social__Providers__0__RedirectUri=
Auth__Social__Providers__1__Provider=
Auth__Social__Providers__1__ClientId=
Auth__Social__Providers__1__AllowedPresenters__0=

# #684 optional purge administration. Inject directly into Host environment.
# Compose .env entries alone are NOT automatically forwarded to the Host container.
Auth__PurgeAdmin__Enabled=false
# Separate 32-byte hex secret (64 hex characters); never reuse another auth key.
Auth__PurgeAdmin__Secret=
# Optional operational settings; existing deletion grace remains unchanged.
Auth__PurgeIntervalMinutes=60
Auth__PurgeRetryMinutes=60
Auth__PurgeCycleCandidates=1000
