# Local-only credential. Copy to .env and generate a unique value; never commit .env.
POSTGRES_PASSWORD=
# Local-only recruit HMAC key, 64+ hex chars (e.g. openssl rand -hex 32). Never commit .env.
RECRUIT_SEED_KEY=
# Local-only account pseudonym HMAC key (ADR0080 §5.1), 64+ hex chars, distinct from the seed key. Never commit .env.
AUTH_PSEUDONYM_KEY=
